{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "go build -o conduit"
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 5,
    "restartPolicyType": "always",
    "startCommand": "./conduit --config config.railway.yaml"
  }
}
